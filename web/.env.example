# Microsoft Entra ID (Azure AD) SSO configuration.
# All values below are blank until the App Registration is created in the Entra ID portal
# (single-tenant, "SPA calls its own API" pattern). See the project plan for the exact steps.
# Leaving these blank is safe: the app detects the missing config and shows a
# "Microsoft sign-in is not yet configured" message instead of crashing.

# App Registration's Application (client) ID.
VITE_MSAL_CLIENT_ID=

# App Registration's Directory (tenant) ID.
VITE_MSAL_TENANT_ID=

# Redirect URI registered as a "Single-page application" platform entry.
# Defaults to window.location.origin at runtime if left blank.
VITE_MSAL_REDIRECT_URI=

# Full API scope string requested for the access token sent to this app's own backend,
# e.g. api://<client-id>/access_as_user
VITE_MSAL_API_SCOPE=

# Absolute origin of the reporting API, only needed when this frontend is deployed
# separately from the API (e.g. a static host on its own domain). Leave blank for local
# dev (uses the Vite proxy) or when the API serves this build itself (relative '/api').
VITE_API_BASE_URL=
