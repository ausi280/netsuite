# FTP credentials for deploying the built frontend to reportes.cryoholdco.com.
# Copy this file to `.env.ftp` (gitignored) and fill in the real values, or export
# these same variables in your shell instead - either way works with scripts/deploy-ftp.mjs.

FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Optional, defaults shown:
FTP_PORT=21
FTP_SECURE=true
FTP_REMOTE_DIR=/
# Set to true only if the deploy script's connection log shows a TLS cert hostname
# mismatch against a server you've otherwise confirmed is correct (common on shared
# hosting, where the cert matches the host's own server name, not your domain).
FTP_TLS_INSECURE=false
